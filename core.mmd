  SHIM --> CON
  SHIM --> FMT
  SHIM -.->|"导入时 load_extensions"| EXTS
  EXTS -.->|"注册 shim"| SHIM
  EXTS --> CON
  EXTS -.->|"ext new / check"| DEV
  CON -->|"数据类型"| TYP
  CON -->|"usage.semantics"| FMT
  CON -->|"routing.py"| DET
  CON -->|"transform 再导出 ir 原语"| IR
  DET --> FMT
  FMT --> TYP
  CAP --> CVT
  DEV --> CON

