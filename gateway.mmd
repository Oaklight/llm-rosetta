flowchart TB
  CLIENT(["客户端<br/>OpenAI / Anthropic / Google 格式"])
  UP(["上游提供方"])
  CORE["llm_rosetta.api + llm_rosetta.contracts<br/>(gateway 进入 core 的唯一入口,测试强制)"]

  subgraph ENTRY["entry"]
    CLI["cli/<br/>llm-rosetta-gateway · banner"]
  end
  subgraph SERVING["serving"]
    APP["app/<br/>factory · routes_llm · routes_typed · routes_models<br/>routes_compact · routes_count_tokens · routes_health · tasks · admin_context"]
    ADMIN["admin/<br/>routes/ · js/ · admin.html"]
    ADMINAPI["admin_api.py<br/>AdminContext 协议"]
  end
  subgraph ENGINE["engine"]
    PROXY["proxy/<br/>prepare · engine · streaming · failover · fidelity · preflight · lifecycle · errors"]
    PIPES["pipelines/<br/>embeddings · rerank · decision"]
  end
  subgraph OPERATIONS["operations"]
    OPS["ops/<br/>OpsBase 审计层 · data · keys · security · proxy"]
  end
  subgraph POLICY["policy"]
    CONFIG["config/<br/>loader · parse · resolve · providers · settings"]
    MW["middleware/<br/>auth · ratelimit · hop_limit · circuit_breaker · request_context"]
  end
  subgraph STATE["state"]
    ROUTING["routing/<br/>select · strategy · failover · session · same_format"]
    QUOTA["quota/<br/>service · allowance · signals · probes · rate_limit"]
    KEYSTORE["keystore/<br/>SQLite API key 库"]
    JOBS["jobs/<br/>envelope · queue · worker · handlers"]
    MAINT["maintenance/<br/>migrations · backfills · dumps · startup · names 守卫"]
  end
  subgraph FOUNDATION["foundation"]
    TRANSPORT["transport/<br/>http · acp · registry · provider_info"]
    OBS["observability/<br/>logging · metrics · request_log · ops_log · error_dump · capture · retention · usage · persistence"]
    SHIMS["shims/<br/>extension_view · manifest_sources(待替换)"]
    MT["model_types/"]
    UPD["updates.py"]
    SURF["surface.py"]
  end

