"""{{distribution}} — {{vendor}} shims for llm-rosetta.

The package ships a ``providers/`` tree and registers it through the
``llm_rosetta.shim_providers`` entry point, so an installed package makes its
shims available to ``llm_rosetta.convert`` and to the gateway without any
configuration.  A gateway may also load the tree from the repository directly
through ``shims.paths`` or ``shims.remotes``.
"""

from __future__ import annotations

from pathlib import Path

__version__ = "0.1.0"

PROVIDERS_DIR = Path(__file__).parent / "providers"


def register_shims() -> list:
    """Register this package's shims and return what was registered."""
    from llm_rosetta.shims.providers import load_providers_from_dir

    return load_providers_from_dir(PROVIDERS_DIR)
