[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "{{distribution}}"
dynamic = ["version"]
description = "{{vendor}} shims for llm-rosetta, delivered as a plugin package"
readme = "README.md"
requires-python = ">=3.10"
license = { text = "MIT" }
dependencies = ["llm-rosetta>={{core_floor}}"]

[project.entry-points."llm_rosetta.shim_providers"]
{{vendor}} = "{{package}}:register_shims"

[tool.setuptools.dynamic]
version = { attr = "{{package}}.__version__" }

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
{{package}} = ["providers/**/*.yaml", "providers/**/*.py"]

[tool.pytest.ini_options]
testpaths = ["tests"]
