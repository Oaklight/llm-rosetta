---
config:
  layout: elk
---
flowchart TB
  subgraph STATE["state"]
    KEYSTORE["keystore/<br/>SQLite API key 库 · maintenance(schema 步骤)"]
    MAINT["maintenance/<br/>backfills · dumps · startup"]
    JOBS["jobs/<br/>envelope · queue · worker · handlers"]
    QUOTA["quota/<br/>service · allowance · lane_allowance · lane_command · signals · probes · rate_limit<br/>lane_allowance(每个 app 一个读数库,重载后重新绑定)· lane_command(本地命令读取)"]
    ROUTING["routing/<br/>select · strategy · failover · session · same_format"]
  end
  subgraph POLICY["policy"]
    CONFIG["config/<br/>loader · parse · resolve · providers · settings · migrate/(配置迁移)<br/>解析与装配;ACP lane 解析在 transport/acp/lane.py"]
    MW["middleware/<br/>auth · ratelimit · hop_limit · circuit_breaker · request_context(client_ip 一次解析,server.trusted_proxies)"]
  end
  subgraph FOUNDATION["foundation"]
    TRANSPORT["transport/<br/>http/ · acp/(transport · chunks · ledger · mcp · meta_client · profile · usage) · registry · provider_info · lane_allowance(接收器接口) · provider_readiness(ProviderNotReady)<br/>http/ · acp/(transport · chunks · ledger · mcp · meta_client · profile · lane(ACP lane 解析)· usage(纯解码)<br/>lane_allowance(接收器接口) · 不导入 quota"]
    SURF["surface.py"]
    OBS["observability/<br/>logging · metrics · request_log(client_ip · peer_ip · forwarded_for) · ops_log · error_dump · capture · retention · usage · persistence"]
    UPD["updates.py"]
    MT["model_types/"]
    SHIMS["shims/<br/>extension_view · manifest_sources · source_view(读扩展 index.json)"]
  end
  subgraph ENGINE["engine"]
    PROXY["proxy/<br/>prepare · attempt(attempt_upstream:上游尝试记账) · engine · streaming · failover · fidelity · preflight · lifecycle · errors<br/>attempt.py:attempt_upstream 是上游尝试记账的唯一入口,pipelines 与 relay 路由经它"]
    PIPES["pipelines/<br/>embeddings · rerank · decision"]
  end
  subgraph OPERATIONS["operations"]
    OPS["ops/<br/>OpsBase 审计层 · data · keys · security · proxy · lifecycle(启动/关闭/重载审计)<br/>唯一的审计写入者"]
  end
  subgraph ENTRY["entry"]
    CLI["cli/<br/>llm-rosetta-gateway · banner<br/>注册 gateway 与 serve 两个命令;gateway 下分发 serve/init/add/credential/password/db/usage/migrate"]
  end
  CLIENT(["客户端<br/>OpenAI / Anthropic / Google 格式"])
  CORE["llm_rosetta.api + llm_rosetta.contracts<br/>(gateway 进入 core 的唯一入口,测试强制)"]
  UP(["上游提供方"])
  subgraph SERVING["serving"]
    ADMINAPI["admin_api.py<br/>AdminContext 协议;不导入 app 与 observability<br/>admin 到 gateway 的唯一通道,含 reload_config"]
    ADMIN["admin/<br/>routes/ · js/ · admin.html"]
    APP["app/<br/>factory · routes_llm · routes_typed · routes_models<br/>routes_compact · routes_count_tokens · routes_health · tasks · admin_context<br/>热重载与唯一的已生效配置"]
  end
  ADMIN -->|"唯一允许"| ADMINAPI
  APP -.->|"只有 factory.py"| ADMIN
  APP --> JOBS
  APP -->|"内置类型处理函数表 BUILTIN_HANDLERS"| PIPES
  APP --> SURF
  APP --> UPD
  CLI -.->|"serve"| APP
  CONFIG --> MW
  CONFIG --> MT
  CONFIG --> ROUTING
  CONFIG --> SHIMS
  JOBS --> OPS
  KEYSTORE --> OBS
  MAINT --> KEYSTORE
  MAINT --> QUOTA
  MW --> KEYSTORE
  OPS --> CONFIG
  PIPES --> PROXY
  PROXY --> MAINT
  PROXY --> OPS
  QUOTA --> OBS
  QUOTA --> TRANSPORT
  ROUTING --> QUOTA
  CONFIG --> CORE
  TRANSPORT -->|HTTP/SSE · ACP stdio| UP
  OBS --> CORE
  SHIMS --> CORE
  TRANSPORT --> CORE
  CLIENT -->|HTTP| APP
  PROXY --> CORE
