{
  "config_version": 1,

  // ALCF Inference Service — all three clusters.
  //
  // The ALCF shims ship as a standalone package (issue #666), so declare its
  // source here: the gateway fetches and caches the repository itself — no
  // pip install and no image rebuild.  Settings → Shim Sources offers the same
  // entry as a one-click preset.
  //
  // First-time setup (once per user):
  //   python3 -m llm_rosetta_shim_alcf.providers.alcf.token --login
  //
  // The package ships the Globus exchange too: each shim declares
  // `connection.token_command` and its refresh interval, so the providers
  // below need no credential wiring at all.  The gateway runs the exchange at
  // startup, on the declared interval and after an upstream 401 — no cron or
  // restarts.  A provider that names its own `token_command` still wins, and a
  // static key is still accepted: "api_key": "${ALCF_API_KEY}".
  //
  // The three providers share the default token file, so the commands may
  // refresh concurrently near expiry; atomic writes keep the file valid, but
  // an external shared refresh process can avoid redundant Globus calls.
  "shims": {
    "remotes": [
      {
        "url": "https://github.com/Oaklight/llm-rosetta-shim-alcf",
        "path": "src/llm_rosetta_shim_alcf/providers"
      }
    ]
  },
  "providers": {
    "alcf-sophia": {
      "shim": "alcf_sophia--chat_completions"
    },
    "alcf-metis": {
      "shim": "alcf_metis--chat_completions"
    },
    "alcf-minerva": {
      "shim": "alcf_minerva--chat_completions"
    }
  },

  "models": {
    // Sophia — vLLM on NVIDIA A100
    "meta-llama/Meta-Llama-3.1-8B-Instruct": "alcf-sophia",
    "meta-llama/Meta-Llama-3.1-70B-Instruct": "alcf-sophia",
    "meta-llama/Meta-Llama-3.1-405B-Instruct": "alcf-sophia",
    "meta-llama/Llama-3.3-70B-Instruct": "alcf-sophia",
    "meta-llama/Llama-4-Scout-17B-16E-Instruct": "alcf-sophia",
    "meta-llama/Llama-4-Maverick-17B-128E-Instruct": "alcf-sophia",
    "openai/gpt-oss-20b": "alcf-sophia",
    "openai/gpt-oss-120b": "alcf-sophia",
    "google/gemma-3-27b-it": "alcf-sophia",
    "google/gemma-4-26B-A4B-it": "alcf-sophia",
    "google/gemma-4-31B-it": "alcf-sophia",
    "google/gemma-4-E4B-it": "alcf-sophia",
    "nvidia/nemotron-3-super-120b": "alcf-sophia",

    // Metis — SambaNova SN40L
    "gpt-oss-120b": "alcf-metis",
    "Mistral-Large-3-675B-Instruct-2512": "alcf-metis",
    "gemma-4-31B-it": "alcf-metis",

    // Minerva — NVIDIA B200
    "nemotron-3-ultra": "alcf-minerva",
    "inkling-bf16": "alcf-minerva"
  },

  "server": {
    "host": "0.0.0.0",
    "port": 8765
  }
}
